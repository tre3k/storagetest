#ifndef _CONFIG_H_
#define _CONFIG_H_

#define PATH_MAX_LENGHT 4096

/*!
 * Изспользовать ли sha256 или sha512
 * Оказывается что на моей машине sha512 работает быстрее чем sha256
 */
#define USE_SHA512 @USE_SHA512@

/*! Размер блока по-умолчанию. 4 кБ */
#define FILE_BLOCK_SIZE_DEFAULT 4096

#if USE_SHA512
#define EVP_SHA() EVP_sha512()
#define SHA(d, n, md) SHA512(d, n, md)
#define SHA_SUM_LENGTH SHA512_DIGEST_LENGTH
#else
#define EVP_SHA() EVP_sha256()
#define SHA(d, n, md) SHA256(d, n, md)
#define SHA_SUM_LENGTH SHA256_DIGEST_LENGTH
#endif

#define APPLICATION_NAME @APPLICATION_NAME@
#define APPLICATION_VERSION @APPLICATION_VERSION@
#define APPLICATION_DESCRIPTION "storagetest", ""

#define BUILT_TIMESTAMP @TODAY_TEXT@
#define BUILT_COMPILER_VERSION @CMAKE_CXX_COMPILER_VERSION_TEXT@
#define BUILT_COMPILER_ID @CMAKE_CXX_COMPILER_ID_TEXT@
#define COPYRIGHT_YEAR @COPY_YEAR_TEXT@

#endif
